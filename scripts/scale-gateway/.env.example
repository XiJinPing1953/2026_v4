SCALE_HEARTBEAT_MS=2000
SCALE_TARGET_WRITE_POLL_MS=1000
SCALE_CONFIG_REFRESH_MS=60000

CRM_SPACE_ID=env-xxxxxxxxxxxxxxxx
CRM_ENDPOINT=
CRM_CLIENT_SECRET=
CRM_ACCESS_KEY=
CRM_SECRET_KEY=
CRM_SPACE_APP_ID=

