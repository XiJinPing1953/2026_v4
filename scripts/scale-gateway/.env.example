SCALE_CODE=filling_scale_main
SCALE_SERIAL_PORT=/dev/tty.usbserial-0001
SCALE_BAUD_RATE=9600
SCALE_DATA_BITS=8
SCALE_STOP_BITS=2
SCALE_PARITY=none
SCALE_SLAVE_ID=1
