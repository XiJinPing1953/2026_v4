{
  "bsonType": "object",
  "description": "Asynchronous station safety inspection workbook export jobs",
  "additionalProperties": false,
  "required": [
    "client_request_id",
    "scope",
    "start_date",
    "end_date",
    "inspection_result",
    "hazard_status",
    "inspection_ids",
    "status",
    "total_count",
    "hazard_count",
    "photo_count",
    "media_count",
    "missing_file_count",
    "file_id",
    "cloud_path",
    "file_name",
    "error_message",
    "worker_token",
    "lease_until",
    "created_by",
    "created_by_name",
    "created_at",
    "updated_at",
    "expires_at"
  ],
  "properties": {
    "_id": { "bsonType": "string" },
    "client_request_id": { "bsonType": "string" },
    "scope": { "bsonType": "string", "enum": ["range", "all"] },
    "start_date": { "bsonType": "string" },
    "end_date": { "bsonType": "string" },
    "start_at": { "bsonType": ["number", "null"] },
    "end_at_exclusive": { "bsonType": ["number", "null"] },
    "inspection_result": { "bsonType": "string" },
    "hazard_status": { "bsonType": "string" },
    "inspection_ids": { "bsonType": "array", "items": { "bsonType": "string" } },
    "status": { "bsonType": "string", "enum": ["queued", "processing", "ready", "failed", "expired"] },
    "total_count": { "bsonType": "int" },
    "hazard_count": { "bsonType": "int" },
    "photo_count": { "bsonType": "int" },
    "media_count": { "bsonType": "int" },
    "missing_file_count": { "bsonType": "int" },
    "file_id": { "bsonType": "string" },
    "cloud_path": { "bsonType": "string" },
    "file_name": { "bsonType": "string" },
    "error_message": { "bsonType": "string" },
    "worker_token": { "bsonType": "string" },
    "lease_until": { "bsonType": "number" },
    "created_by": { "bsonType": "string" },
    "created_by_name": { "bsonType": "string" },
    "created_at": { "bsonType": "number" },
    "updated_at": { "bsonType": "number" },
    "expires_at": { "bsonType": "number" }
  },
  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "indexes": [
    { "key": { "created_by": 1, "client_request_id": 1 }, "name": "uniq_owner_request", "unique": true },
    { "key": { "created_by": 1, "created_at": -1 }, "name": "idx_owner_created" },
    { "key": { "status": 1, "lease_until": 1 }, "name": "idx_status_lease" },
    { "key": { "expires_at": 1 }, "name": "idx_expires" }
  ]
}
