    "create": false,
    "update": false,
    "delete": false
  },
  "indexes": [
    { "key": { "epc": 1 }, "name": "uniq_epc", "unique": true },
    { "key": { "entity_type": 1, "entity_id": 1 }, "name": "idx_entity" },
    { "key": { "entity_type": 1, "entity_no": 1 }, "name": "idx_entity_no" },
    { "key": { "status": 1, "updated_at": -1 }, "name": "idx_status_updated_at" }
