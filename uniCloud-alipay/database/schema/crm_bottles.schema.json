{
  "bsonType": "object",
  "description": "CRM bottles (master data)",
  "additionalProperties": false,
  "required": [
    "bottle_no",
    "tare_weight",
    "status",
    "current_customer_id",
    "current_customer_name",
    "remark",
    "is_active",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "_id": { "bsonType": "string" },
    "bottle_no": { "bsonType": "string" },
    "bottle_no_sort_group": { "bsonType": "number" },
    "bottle_no_sort_num": { "bsonType": ["number", "null"] },
    "bottle_no_sort_text": { "bsonType": "string" },
    "bottle_no_sort_key": { "bsonType": "string" },
    "filling_company": { "bsonType": "string" },
    "registration_mark": { "bsonType": "string" },
    "equipment_type": { "bsonType": "string" },
    "product_no": { "bsonType": "string" },
    "qr_code": { "bsonType": "string" },
    "pda_qr_code": { "bsonType": "string" },
    "gas_medium_code": { "bsonType": "string", "enum": ["LNG", "LPG", "O2", "N2", "Ar", "OTHER"] },
    "station_id": { "bsonType": "string" },
    "manufacturer": { "bsonType": "string" },
    "volume_l": { "bsonType": ["number", "null"] },
    "manufacture_date": { "bsonType": "string" },
    "bottle_check_date": { "bsonType": "string" },
    "bottle_next_check_date": { "bsonType": "string" },
    "bottle_check_cycle_months": { "bsonType": "number" },
    "scrap_due_date": { "bsonType": "string" },
    "pressure_gauge_no": { "bsonType": "string" },
    "pressure_gauge_manufacturer": { "bsonType": "string" },
    "pressure_gauge_range_min": { "bsonType": ["number", "null"] },
    "pressure_gauge_range_max": { "bsonType": ["number", "null"] },
    "pressure_gauge_check_date": { "bsonType": "string" },
    "pressure_gauge_next_check_date": { "bsonType": "string" },
    "pressure_gauge_cycle_months": { "bsonType": "number" },
    "safety_valve_count": { "bsonType": "number" },
    "safety_valve_check_date": { "bsonType": "string" },
    "safety_valve_next_check_date": { "bsonType": "string" },
    "safety_valve_cycle_months": { "bsonType": "number" },
    "tare_weight": { "bsonType": ["number", "null"] },
    "suggested_fill_weight_kg": { "bsonType": ["number", "null"] },
    "status": {
      "bsonType": "string",
      "enum": ["unknown", "in_station", "at_customer", "scrapped", "lost"]
    },
    "current_customer_id": { "bsonType": ["string", "null"] },
    "current_customer_name": { "bsonType": "string" },
    "remark": { "bsonType": "string" },
    "is_active": { "bsonType": "bool" },
    "created_at": { "bsonType": "number" },
    "updated_at": { "bsonType": "number" }
  },
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "indexes": [
    { "key": { "bottle_no": 1 }, "name": "bottle_no", "unique": true },
    { "key": { "qr_code": 1 }, "name": "idx_qr_code" },
    { "key": { "pda_qr_code": 1 }, "name": "idx_pda_qr_code" },
    { "key": { "pressure_gauge_no": 1 }, "name": "idx_pressure_gauge_no" },
    { "key": { "station_id": 1, "is_active": 1, "updated_at": -1 }, "name": "idx_station_active_updated_at" },
    { "key": { "gas_medium_code": 1, "updated_at": -1 }, "name": "idx_medium_updated_at" },
    { "key": { "status": 1 }, "name": "idx_status" },
    { "key": { "current_customer_id": 1 }, "name": "idx_current_customer_id" },
    { "key": { "bottle_no_sort_key": 1 }, "name": "idx_bottle_no_sort_key" },
    { "key": { "is_active": 1, "bottle_no_sort_key": 1 }, "name": "idx_active_bottle_no_sort_key" },
    { "key": { "is_active": 1, "updated_at": -1 }, "name": "idx_active_updated_at" },
    { "key": { "updated_at": -1 }, "name": "idx_updated_at" }
  ]
}
