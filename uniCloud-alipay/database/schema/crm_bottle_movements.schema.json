{
  "bsonType": "object",
  "description": "Bottle movement events (event stream)",
  "additionalProperties": false,
  "required": [
    "bottle_no",
    "type",
    "date",
    "event_day",
    "event_at",
    "type_order",
    "source_type",
    "source_id",
    "created_at",
    "created_by"
  ],
  "properties": {
    "_id": { "bsonType": "string" },
    "bottle_no": { "bsonType": "string" },
    "type": { "bsonType": "string", "enum": ["back", "fill", "out", "adjust"] },
    "date": { "bsonType": "string" },
    "event_day": { "bsonType": "string" },
    "event_at": { "bsonType": "number" },
    "type_order": { "bsonType": "number" },
    "source_type": { "bsonType": "string", "enum": ["sale", "filling", "manual_fix", "manual"] },
    "source_id": { "bsonType": ["string", "null"] },
    "customer_id": { "bsonType": ["string", "null"] },
    "customer_name": { "bsonType": "string" },
    "net_weight": { "bsonType": ["number", "null"] },
    "loss_weight": { "bsonType": ["number", "null"] },
    "note": { "bsonType": "string" },
    "created_at": { "bsonType": "number" },
    "created_by": { "bsonType": ["string", "null"] },
    "created_by_name": { "bsonType": "string" }
  },
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "indexes": [
    { "key": { "bottle_no": 1, "date": 1, "created_at": 1 }, "name": "idx_bottle_date" },
    { "key": { "bottle_no": 1, "event_at": 1, "type_order": 1, "created_at": 1 }, "name": "idx_bottle_event" },
    { "key": { "type": 1, "date": -1 }, "name": "idx_type_date" },
    { "key": { "type": 1, "event_at": -1 }, "name": "idx_type_event" },
    { "key": { "source_type": 1, "source_id": 1 }, "name": "idx_source" },
    { "key": { "type": 1, "event_day": 1, "event_at": 1, "created_at": 1 }, "name": "idx_type_event_day_event_at" },
    { "key": { "type": 1, "source_type": 1, "event_day": 1, "event_at": 1, "created_at": 1 }, "name": "idx_type_source_event_day" }
  ]
}
