{
  "bsonType": "object",
  "description": "Sales records (input-first clean model)",
  "additionalProperties": false,
  "required": [
    "date",
    "customer_id",
    "customer_name",
    "biz_mode",
    "price_unit",
    "unit_price",
    "payment_status",
    "amount_received",
    "created_at",
    "created_by",
    "updated_at",
    "source"
  ],
  "properties": {
    "_id": { "bsonType": "string" },

    "date": { "bsonType": "string" },
    "customer_id": { "bsonType": "string" },
    "customer_name": { "bsonType": "string" },

    "delivery_man": { "bsonType": "string" },
    "vehicle_id": { "bsonType": "string" },
    "car_no": { "bsonType": "string" },

    "biz_mode": { "bsonType": "string" },
    "price_unit": { "bsonType": "string" },
    "unit_price": { "bsonType": ["number", "null"] },

    "remark": { "bsonType": "string" },

    "payment_status": { "bsonType": "string" },
    "amount_received": { "bsonType": ["number", "null"] },
    "rounding_amount": { "bsonType": ["number", "null"] },
    "payment_note": { "bsonType": "string" },
    "payment_method": { "bsonType": "string" },

    "out_items": {
      "bsonType": "array",
      "items": {
        "bsonType": "object",
        "properties": {
          "bottle_no": { "bsonType": "string" },
          "bottle_id": { "bsonType": ["string", "null"] },
          "gross": { "bsonType": ["number", "null"] },
          "tare": { "bsonType": ["number", "null"] },
          "net": { "bsonType": ["number", "null"] },
          "address": { "bsonType": "string" }
        }
      }
    },
    "back_items": {
      "bsonType": "array",
      "items": {
        "bsonType": "object",
        "properties": {
          "bottle_no": { "bsonType": "string" },
          "bottle_id": { "bsonType": ["string", "null"] },
          "gross": { "bsonType": ["number", "null"] },
          "tare": { "bsonType": ["number", "null"] },
          "net": { "bsonType": ["number", "null"] }
        }
      }
    },

    "deposit_rows": {
      "bsonType": "array",
      "items": {
        "bsonType": "object",
        "properties": {
          "bottle_no": { "bsonType": "string" },
          "bottle_id": { "bsonType": ["string", "null"] }
        }
      }
    },

    "agent_sale_items": {
      "bsonType": "array",
      "items": {
        "bsonType": "object",
        "properties": {
          "bottle_no": { "bsonType": "string" },
          "bottle_id": { "bsonType": ["string", "null"] },
          "fill_weight": { "bsonType": ["number", "null"] },
          "address": { "bsonType": "string" },
          "filling_record_id": { "bsonType": ["string", "null"] }
        }
      }
    },

    "truck_no": { "bsonType": ["string", "null"] },
    "truck_out_gross": { "bsonType": ["number", "null"] },
    "truck_back_gross": { "bsonType": ["number", "null"] },
    "truck_sale_net": { "bsonType": ["number", "null"] },

    "flow_index_prev": { "bsonType": ["number", "null"] },
    "flow_index_curr": { "bsonType": ["number", "null"] },
    "flow_volume_m3": { "bsonType": ["number", "null"] },
    "flow_theory_ratio": { "bsonType": ["number", "null"] },

    "created_at": { "bsonType": "number" },
    "created_by": { "bsonType": ["string", "null"] },
    "updated_at": { "bsonType": ["number", "null"] },
    "source": { "bsonType": "string" }
  },
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "indexes": [
    { "key": { "date": -1, "created_at": -1 }, "name": "idx_date_created_at" },
    { "key": { "customer_id": 1, "date": -1 }, "name": "idx_customer_date" },
    { "key": { "truck_no": 1, "date": -1 }, "name": "idx_truck_date" },
    { "key": { "price_unit": 1, "date": -1 }, "name": "idx_price_unit_date" },
    { "key": { "biz_mode": 1, "date": -1 }, "name": "idx_biz_mode_date" }
  ]
}
