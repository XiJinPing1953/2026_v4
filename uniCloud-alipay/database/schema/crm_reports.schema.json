{
  "bsonType": "object",
  "description": "Accounting reports (snapshot)",
  "additionalProperties": false,
  "required": [
    "period",
    "type",
    "payload",
    "created_at"
  ],
  "properties": {
    "_id": { "bsonType": "string" },
    "period": { "bsonType": "string" },
    "type": { "bsonType": "string", "enum": ["trial_balance", "income_statement", "balance_sheet"] },
    "payload": { "bsonType": "object" },
    "created_at": { "bsonType": "number" }
  },
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "indexes": [
    { "key": { "period": 1, "type": 1 }, "name": "uniq_period_type", "unique": true }
  ]
}
