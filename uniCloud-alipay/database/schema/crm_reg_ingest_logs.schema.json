{
  "bsonType": "object",
  "description": "Regulatory ingest request logs",
  "additionalProperties": false,
  "required": [
    "station_id",
    "payload_type",
    "dedup_key",
    "status",
    "reason_code",
    "reason_msg",
    "request_id",
    "request_body_sha256",
    "created_at"
  ],
  "properties": {
    "_id": { "bsonType": "string" },
    "station_id": { "bsonType": "string" },
    "payload_type": { "bsonType": "string", "enum": ["snapshot", "event"] },
    "dedup_key": { "bsonType": "string" },
    "status": { "bsonType": "string", "enum": ["accepted", "repeated", "rejected"] },
    "reason_code": { "bsonType": "string" },
    "reason_msg": { "bsonType": "string" },
    "request_id": { "bsonType": "string" },
    "request_body_sha256": { "bsonType": "string" },
    "source_type": { "bsonType": "string" },
    "source_id": { "bsonType": ["string", "null"] },
    "bottle_no": { "bsonType": "string" },
    "event_at": { "bsonType": ["number", "null"] },
    "created_at": { "bsonType": "number" }
  },
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "indexes": [
    { "key": { "dedup_key": 1, "created_at": -1 }, "name": "idx_dedup_created" },
    { "key": { "status": 1, "created_at": -1 }, "name": "idx_status_created" },
    { "key": { "station_id": 1, "created_at": -1 }, "name": "idx_station_created" }
  ]
}
