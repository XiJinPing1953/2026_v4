{
  "bsonType": "object",
  "additionalProperties": false,
  "description": "Permanent mobile sale creation receipts; never delete with a sale, no automatic side-effect replay.",
  "required": [
    "operation_id",
    "payload_digest",
    "sale_id",
    "created_by",
    "processing_state",
    "warnings",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "_id": {
      "bsonType": "string"
    },
    "operation_id": {
      "bsonType": "string"
    },
    "payload_digest": {
      "bsonType": "string"
    },
    "side_effect_token_hash": {
      "bsonType": "string",
      "description": "SHA-256 of an internal server-only capability; raw token is never persisted or returned"
    },
    "side_effect_claims": {
      "bsonType": "array",
      "description": "At-most-once downstream steps; claimed before execution, never automatically replayed",
      "items": {
        "bsonType": "string",
        "enum": [
          "crm-filling:syncStartLossAdjustmentsV1",
          "crm-customer-settlement:autoApplyPrepayToSaleV1",
          "crm-bottle-anomaly:touchV2"
        ]
      }
    },
    "sale_id": {
      "bsonType": "string"
    },
    "created_by": {
      "bsonType": "string"
    },
    "processing_state": {
      "bsonType": "string",
      "enum": [
        "processing",
        "completed",
        "pending_review"
      ]
    },
    "warnings": {
      "bsonType": "array",
      "items": {
        "bsonType": "string"
      }
    },
    "created_at": {
      "bsonType": "number"
    },
    "updated_at": {
      "bsonType": "number"
    }
  },
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "indexes": [
    {
      "name": "idx_processing_created",
      "key": {
        "processing_state": 1,
        "created_at": 1
      }
    }
  ]
}
