  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "indexes": [
    { "key": { "client_submission_id": 1 }, "name": "uniq_client_submission_id", "unique": true },
    { "key": { "inspection_no": 1 }, "name": "uniq_inspection_no", "unique": true },
    { "key": { "station_id": 1, "inspection_at": -1 }, "name": "idx_station_inspection_at" },
    { "key": { "overall_result": 1, "inspection_at": -1 }, "name": "idx_result_inspection_at" }
  ]
