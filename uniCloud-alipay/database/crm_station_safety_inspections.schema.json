        "required": [
          "area_code",
          "area_label_snapshot",
          "item_code",
          "item_label_snapshot",
          "hazard_category_snapshot",
          "result_code",
          "result_label_snapshot",
          "is_abnormal",
          "issue_note",
          "hazard_level",
          "responsible_name",
          "planned_measure",
          "planned_complete_date",
          "responsible_signature_file_id",
          "photo_file_ids"
        ],
        "properties": {
          "area_code": { "bsonType": "string" },
          "area_label_snapshot": { "bsonType": "string" },
          "item_code": { "bsonType": "string" },
          "item_label_snapshot": { "bsonType": "string" },
          "hazard_category_snapshot": { "bsonType": "string" },
          "result_code": { "bsonType": "string", "enum": ["normal", "abnormal"] },
          "result_label_snapshot": { "bsonType": "string" },
          "is_abnormal": { "bsonType": "bool" },
          "issue_note": { "bsonType": "string" },
          "hazard_level": { "bsonType": "string" },
          "responsible_name": { "bsonType": "string" },
          "planned_measure": { "bsonType": "string" },
          "planned_complete_date": { "bsonType": "string" },
          "responsible_signature_file_id": { "bsonType": "string" },
          "photo_file_ids": { "bsonType": "array", "items": { "bsonType": "string" } }
        }
      }
    },
    "overall_result": { "bsonType": "string", "enum": ["normal", "abnormal"] },
    "inspector_name": { "bsonType": "string" },
    "inspector_user_id": { "bsonType": "string" },
    "inspector_username_snapshot": { "bsonType": "string" },
    "abnormal_count": { "bsonType": "int" },
    "photo_count": { "bsonType": "int" },
    "remark": { "bsonType": "string" },
    "status": { "bsonType": "string", "enum": ["submitted"] },
    "source": { "bsonType": "string", "enum": ["h5"] },
    "created_at": { "bsonType": "number" },
    "created_by": { "bsonType": "string" },
    "created_by_name": { "bsonType": "string" },
    "updated_at": { "bsonType": "number" },
    "last_edited_at": { "bsonType": ["number", "null"] },
    "last_edited_by": { "bsonType": "string" },
    "last_edited_by_name": { "bsonType": "string" }
