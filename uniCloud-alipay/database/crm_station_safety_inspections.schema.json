{
  "bsonType": "object",
  "description": "Station safety inspection records",
  "additionalProperties": false,
  "required": [
    "client_submission_id",
    "inspection_no",
    "station_id",
    "station_name_snapshot",
    "inspection_at",
    "inspection_date",
    "template_code",
    "template_version",
    "template_title_snapshot",
    "items",
    "overall_result",
    "inspector_name",
    "inspector_user_id",
    "inspector_username_snapshot",
    "abnormal_count",
    "photo_count",
    "status",
    "source",
    "created_at",
    "created_by",
    "created_by_name",
    "updated_at"
  ],
  "properties": {
