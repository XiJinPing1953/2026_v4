      "bsonType": [
        "number",
        "null"
      ]
    },
    "deviation": {
      "bsonType": [
        "number",
        "null"
      ]
    },
    "scale_source": {
      "bsonType": [
        "string",
        "null"
      ]
    },
    "scale_read_mode": {
      "bsonType": [
        "string",
        "null"
      ]
    },
